<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AccessRequestSystem.API</RootNamespace>
    <UserSecretsId>accessrequestsystem-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- EF Tools (PMC/dotnet-ef) требуют, чтобы Design-пакет был виден именно со стороны
         стартового проекта, а не только со стороны DAL, где лежит DbContext -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessRequestSystem.BLL\AccessRequestSystem.BLL.csproj" />
    <ProjectReference Include="..\AccessRequestSystem.DAL\AccessRequestSystem.DAL.csproj" />
  </ItemGroup>

</Project>
