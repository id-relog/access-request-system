@model ServiceFormViewModel
@{
    ViewData["Title"] = "Новый сервис";
}

<div class="card p-4">
    <h3 class="mb-3">Добавить сервис в справочник</h3>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form asp-controller="Admin" asp-action="CreateService" method="post">
        @await Html.PartialAsync("_ServiceFormFields", Model)
        <button type="submit" class="btn btn-primary">Добавить</button>
    </form>
</div>
